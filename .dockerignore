.git
.gitignore
.dockerignore
.claude
.vscode
.idea
__pycache__
*.pyc
*.pyo
*.pyd
*.nbi
*.nbc

# Output / runtime artefacts
python/output
python/output_*
*.log

# Reference papers (ship separately)
reference

# Sample data & derived artefacts — mounted at run-time, never baked in
lib/**/*.tif
lib/**/*.tiff
lib/**/*.tfw
lib/**/*.mat
lib/**/*.shp
lib/**/*.shx
lib/**/*.dbf
lib/**/*.prj
lib/**/*.cpg
lib/**/*.qpj
lib/**/*.gpkg
lib/**/*.geojson
lib/**/*.pdf
lib/**/*.pptx
lib/**/*.zip
lib/**/*.xml
post_processing/**/*.tif
post_processing/**/*.mat

# Local scratch / diagnostic scripts (not part of the shipped pipeline)
python/_*.py

# Tests are not needed for container runtime
python/tests
