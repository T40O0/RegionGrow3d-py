.git
.gitignore
.dockerignore
.claude
.vscode
.idea
__pycache__
*.pyc
*.pyo
*.pyd
*.nbi
*.nbc

# Output / runtime artefacts
python/output
python/output_*
*.log

# Reference papers (ship separately)
reference

# Sample data & derived artefacts — mounted at run-time, never baked in
lib/**/*.tif
lib/**/*.tiff
lib/**/*.tfw
lib/**/*.mat
lib/**/*.shp
lib/**/*.shx
lib/**/*.dbf
lib/**/*.prj
lib/**/*.cpg
lib/**/*.qpj
lib/**/*.gpkg
lib/**/*.geojson
lib/**/*.pdf
lib/**/*.pptx
lib/**/*.zip
lib/**/*.xml
# Post-processing is local working data (gitignored) and is bind-mounted with
# `-v` when its scripts are run in the container — baking it in would ship ~170
# MB of stale copies that silently shadow the real thing on a mount-less run.
post_processing

# Local scratch / diagnostic scripts (not part of the shipped pipeline)
python/_*.py
# ...except the parallel orchestrator: gui.py launches it by path, and
# docker-compose.yml does not mount ./python, so excluding it breaks the UI's
# parallel mode with FileNotFoundError on a compose-started container.
!python/_sus_parallel.py

# Tests are not needed for container runtime
python/tests
