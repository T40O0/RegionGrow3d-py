# Python bytecode / Numba JIT cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.nbi
*.nbc

# Output / runtime artifacts
python/output/
python/output_*/
*.log

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Sample / binary data (DEMs, .mat, reference outputs) -------------------
# These are large and / or distributable separately from the source tree.
# To run the project you need to place a DEM under `lib/DEM/` and (optionally)
# the matching MATLAB-generated .mat files under `lib/soil_depth/` etc.

# DEMs
lib/DEM/*.tif
lib/DEM/*.tiff
lib/DEM/*.tif.aux.xml
lib/DEM/*.tif.ovr

# All .mat under lib/ (preprocess inputs / lookup tables / Python-saved outputs)
lib/**/*.mat

# Soil-depth derived products
lib/soil_depth/*.tif
lib/soil_depth/*.tif.aux.xml
lib/soil_depth/*.tif.ovr

# MATLAB reference outputs
post_processing/**/*.mat
post_processing/**/*.tif
post_processing/**/*.tif.aux.xml
post_processing/**/*.tif.ovr

# Rendered figures bake in third-party basemap tiles and restricted
# inventory/DEM data — do not commit.
docs/img/

# Site-specific analysis / visualization scratch scripts and the methodology
# write-up — depend on restricted data and are not for publication.
python/_*.py
docs/nogrow_method_ja.md

# Reference materials (third-party papers, shortcuts, MATLAB function specs).
# Contents may include copyrighted PDFs (e.g. journal articles) — exclude
# the whole folder from version control.
reference/

# Original USGS MATLAB sources (`lib/driver.m`, `lib/functions/*.m`,
# `lib/hydro_interp/*.m`, `post_processing/susceptibility_map.m`).
# Also the `lib/hydro_interp/` lookup tables (used by mode 2 only, which is
# not supported by this Python port).
# This repository ships only the Python port; the MATLAB originals remain
# available at <https://code.usgs.gov/ghsc/lhp/regiongrow3d>.
*.m
lib/hydro_interp/

# Development / verification scripts that depend on private MATLAB outputs.
# These are not shipped with the public source tree; obtain or recreate them
# locally if you need to reproduce the MATLAB-vs-Python comparison.
python/tests/
python/compare_with_matlab.py
python/analyze_diff.py
python/verify_against_upstream.py

# Streamlit local secrets / cache
.streamlit/

# Claude Code session metadata
.claude/
